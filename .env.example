# GEMINI_API_KEY: Required for Gemini AI API calls (document extraction).
# Configure in AI Studio Secrets or in Netlify Site configuration > Environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional overrides for Netlify / self-hosted deployments:
# APP_ACCESS_PASSWORD="4907"
# SESSION_SECRET="CHANGE_TO_A_RANDOM_SECRET"
